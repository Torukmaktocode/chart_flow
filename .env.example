# ═══════════════════════════════════════════
#  CHART FLOW — Variables de Entorno
#  Copia este archivo a .env y completa los valores
# ═══════════════════════════════════════════

# Token del Bot de Telegram (obligatorio para bots)
# Obtén tu token hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID para mensajes (obligatorio para bots)
# Obtén tu chat ID hablando con @userinfobot
TELEGRAM_CHAT_ID=

# Polygon.io API Key (opcional — para datos de mercado alternativos)
POLYGON_API_KEY=

# Finnhub API Token (opcional — para datos de acciones en tiempo real)
FINNHUB_TOKEN=

# Massive API Key (opcional — para datos de mercado en tiempo real)
MASSIVE_API_KEY=

# Puerto del servidor API principal (default: 8787)
SERVER_PORT=8787

# Modo de desarrollo: development | production
NODE_ENV=development