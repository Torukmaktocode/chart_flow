{
  "name": "quant-free-dashboard",
  "version": "2.0.0",
  "description": "Sistema completo de dashboards y herramientas de trading en tiempo real",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "bot": "node telegram-bot.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dashboards": ".\\scripts\\start-unified.ps1",
    "stop": ".\\scripts\\stop-unified.ps1",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext js,jsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "canvas": "^3.2.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "lucide-react": "^0.468.0",
    "node-telegram-bot-api": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.1",
    "yahoo-finance2": "^2.11.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": ["trading", "dashboard", "forex", "crypto", "stocks", "real-time", "react", "nodejs"],
  "author": "Trading Dashboard Developer",
  "license": "Private",
  "engines": { "node": ">=18.0.0" }
}
